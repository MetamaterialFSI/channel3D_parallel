&params
	! domain size
	nx_global = 64
	ny_global = 65
	nz_global = 64
	nxb = 32
	nzb = 16
	! (positive->CFL, negative->timestep size)
	CFL = -0.0001
	! viscosity
	nu = 4.3689e-04
	! Pressure gradient
	dPdx = 0.000000
	dPdz = 0.000000000000
	x_mass_cte = 0 ! (0->use dPdx, 1->constant mass flow)
	y_mass_cte = 0
