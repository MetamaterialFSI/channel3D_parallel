    m_parm=10000   !mass coeff for a single subsurface unit cell 
    k_parm=10000   !stiffness coeff for a single subsurface unit cell 
    c_parm=1       !damping coeff for a single subsurface unit cell 
    xtopmass=0.9   !x-position of topmost subsurface unit cell
    ytopmass=2.00  !y-position of topmost subsurface unit cell 
    ztopmass=0.45  !z-position of topmost subsurface unit cell 
