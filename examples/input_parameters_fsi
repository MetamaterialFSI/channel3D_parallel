	k_parm_testcase=10 ! stiffness of compliant wall in 2014 kim et al.
	c_parm_testcase=0.5 !damping coefficient of compliant wall in 2014 kim et al. paper
	Tx=0 !tension coefficient in x direction
	Tz=0 !tension coefficient in y direction
	A=1  !projected area
