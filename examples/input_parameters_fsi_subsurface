    k_parm=100   !stiffness coeff for a single subsurface unit cell 
    c_parm=0       !damping coeff for a single subsurface unit cell 
    xtopmass=0.9   !x-position of topmost subsurface unit cell
    ytopmass=2.00  !y-position of topmost subsurface unit cell 
    ztopmass=0.45  !z-position of topmost subsurface unit cell 
    sigma=0.3 !gaussian function parameter
