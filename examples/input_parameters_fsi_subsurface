&params
	! domain size
	nx_global = 34
	ny_global = 131
	nz_global = 34
	nxb = 16
	nzb = 16
	! (positive->CFL, negative->timestep size)
	CFL = -0.0001
	! viscosity
	nu = 3.076923076923077e-04 
	! Pressure gradient
	dPdx = 0.00000000
	dPdz = 0.000000000000
	x_mass_cte = 0 ! (0->use dPdx, 1->constant mass flow)
	y_mass_cte = 0
