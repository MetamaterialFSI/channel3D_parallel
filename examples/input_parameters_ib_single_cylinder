&params
	! domain size
	nx_global = 66
	ny_global = 65
	nz_global = 10
	nxb = 0 ! Is determined in the code such that dxb / dx matches dzb / dz
	nzb = 8
	Lxp = 4.0
	Lzp = 1.0
	Ly_channel = 4.0
	! (positive->CFL, negative->timestep size)
	CFL = -0.0005
	! viscosity
	nu = 1.0 
	! Pressure gradient
	dPdx = 0.00
	dPdz = 0.000000000000 
	x_mass_cte = 0 ! (0->use dPdx, 1->constant mass flow)
	y_mass_cte = 0
	! nsteps, nsave, nstats, nmonitor
	nsteps = 4000
	nsave = 100
	nstats = 1000
	nmonitor = 10
	filein = ''
	fileout = 'channel_output_ib_single_cylinder/test'
	! first number for output flow field
	nstep_init = 0
	init_type = 1 ! (0->reads previous file, 1->zero, 2->random)
	grid_type = 0 ! (0->uniform, 1->stretched, 2->stretched with uniform buffers)
	body_type = 'single_cylinder_z'
	body_param_1 = 0.75 ! radius of cylinder
	body_param_2 = 0.15 ! y-velocity of cylinder
	body_ramp_up_time = 0.5
	cg_tol = 1e-10
/
